## The Energy saving pane of the settings window.

energy-saving-title = Energy saving
energy-saving-summary = TypeAlike can stop suggestions and unload the model when you do not need them. This frees memory and uses less power.
energy-saving-idle-timeout = Stop when inactive
energy-saving-idle-timeout-description = When you do not type or click for this time, TypeAlike stops suggestions and unloads the model. It loads the model again when you type in a text field.
energy-saving-idle-timeout-off = Off
energy-saving-idle-timeout-minutes = { $minutes } minutes
energy-saving-energy-saver = Stop in energy saver
energy-saving-energy-saver-description = While energy saver or Low Power Mode is on, TypeAlike stops suggestions and unloads the model. Suggestions start again when it goes off.
energy-saving-energy-saver-stopped = The computer saves energy now, so suggestions are off.
energy-saving-game = Stop during games
energy-saving-game-description = While a game is in front, TypeAlike stops suggestions and unloads the model. It loads the model again when you type in a text field after the game.

## The menu of the badge at the caret. $app is the name of an app, and $host is the host of a website, such as mail.example.com.

badge-app-suggestions = Show suggestions in { $app }
badge-site-suggestions = Show suggestions on { $host }
badge-app-screen-text = Use screen text in { $app }
badge-app-earlier-writing = Earlier writing in { $app }
